name: Deploy Azure App Service

on:
  workflow_dispatch:

# Required for Azure OIDC authentication
permissions:
  id-token: write
  contents: read

env:
  AZURE_WEBAPP_NAME: ${{ secrets.AZURE_WEBAPP_NAME }}
  AZURE_RESOURCE_GROUP: ${{ secrets.AZURE_RESOURCE_GROUP }}
  AZURE_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

jobs:

  build:
    name: Build Application
    runs-on: ubuntu-latest

    steps:

      # --------------------------------------------------
      # Checkout source code
      # --------------------------------------------------
      - name: Checkout Code
        uses: actions/checkout@v4

      # --------------------------------------------------
      # Setup Node.js
      # Change version if your application requires another
      # --------------------------------------------------
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm

      # --------------------------------------------------
      # Install dependencies
      # --------------------------------------------------
      - name: Install Dependencies
        run: npm ci

      # --------------------------------------------------
      # Build application
      # --------------------------------------------------
      - name: Build Application
        run: npm run build

      # --------------------------------------------------
      # Prepare deployment package
      # --------------------------------------------------
      - name: Prepare Deployment Package
        run: |
          mkdir -p deployment
          cp -r .next deployment/
          cp -r public deployment/ 2>/dev/null || true
          cp package.json deployment/
          cp package-lock.json deployment/
          
          if [ -f next.config.js ]; then
            cp next.config.js deployment/
          fi

          if [ -f next.config.mjs ]; then
            cp next.config.mjs deployment/
          fi

      # --------------------------------------------------
      # Upload build artifact
      # --------------------------------------------------
      - name: Upload Deployment Artifact
        uses: actions/upload-artifact@v4
        with:
          name: webapp-package
          path: deployment/


  deploy:
    name: Deploy to Azure App Service
    runs-on: ubuntu-latest
    needs: build

    steps:

      # --------------------------------------------------
      # Download build artifact
      # --------------------------------------------------
      - name: Download Deployment Artifact
        uses: actions/download-artifact@v4
        with:
          name: webapp-package
          path: deployment

      # --------------------------------------------------
      # Azure Login using OIDC
      # --------------------------------------------------
      - name: Azure Login
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      # --------------------------------------------------
      # Verify Azure authentication
      # --------------------------------------------------
      - name: Verify Azure Login
        run: |
          az account show
          az account set --subscription "${{ secrets.AZURE_SUBSCRIPTION_ID }}"

      # --------------------------------------------------
      # Verify App Service exists
      # --------------------------------------------------
      - name: Verify App Service
        run: |
          az webapp show \
            --name "${{ secrets.AZURE_WEBAPP_NAME }}" \
            --resource-group "${{ secrets.AZURE_RESOURCE_GROUP }}"

      # --------------------------------------------------
      # Deploy application
      # --------------------------------------------------
      - name: Deploy to Azure Web App
        uses: azure/webapps-deploy@v2
        with:
          app-name: ${{ secrets.AZURE_WEBAPP_NAME }}
          resource-group-name: ${{ secrets.AZURE_RESOURCE_GROUP }}
          package: ./deployment

      # --------------------------------------------------
      # Logout
      # --------------------------------------------------
      - name: Azure Logout
        run: |
          az logout
